# Copiá este archivo como .env y completá los valores.
# El archivo .env REAL no se sube a GitHub (está en el .gitignore).

# MongoDB local:
MONGODB_URI=mongodb://localhost:27017

# MongoDB Atlas (reemplazá usuario, clave y cluster):
# MONGODB_URI=mongodb+srv://USUARIO:CLAVE@cluster0.xxxxx.mongodb.net/

# Nombre de la base de datos que se va a usar
DB_NAME=tienda_electronica
